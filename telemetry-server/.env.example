# Copy to Vercel → Project → Settings → Environment Variables (do NOT commit real values)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=guard
# optional shared secret agents must send (X-Guard-Token) to POST telemetry
INGEST_TOKEN=change-me-long-random
# optional secret to view the dashboard/API (?token=... )
DASH_TOKEN=change-me-long-random
